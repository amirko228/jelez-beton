# Скопируйте на сервер как .env и подставьте свой домен/IP
POSTGRES_DB=jelez_beton
POSTGRES_USER=jelez
POSTGRES_PASSWORD=замените_на_длинный_пароль
DATABASE_URL=postgresql://jelez:замените_на_длинный_пароль@db:5432/jelez_beton?schema=public

JWT_SECRET=замените_на_случайную_строку_32_символа
JWT_EXPIRES_IN=1d

# Публичный адрес сайта (без слэша в конце)
CLIENT_URL=http://ВАШ_ДОМЕН_ИЛИ_IP
ADMIN_URL=http://ВАШ_ДОМЕН_ИЛИ_IP/admin
NEXT_PUBLIC_API_URL=http://ВАШ_ДОМЕН_ИЛИ_IP/api

# Опционально: уведомления в WhatsApp (CallMeBot)
# WHATSAPP_NOTIFY_PHONE=
# WHATSAPP_NOTIFY_API_KEY=
